int Choice()
{
    int choice;
    do {
        Menu();
        cin >> choice;
        if (choice < 1 || choice > 6) {
            system("cls");
            kiko::erorr();
            kiko::alert(3);
            system("cls");
        }
    } while (choice < 1 || choice > 6);
    return choice;
}
void runProcessOfUser(int choice)
{
    switch (choice) {
    case 1:
        runAdditionProgram();
        break;
    case 2:
        runSubtractionProgram();
        break;
    case 3:
        runMultiplicationProgram();
        break;
    case 4:
        runDivisionProgram();
        break;
    case 5:
        runPowerAndBaseProgram();
        break;
    case 6:
        runRootsProgram();
        break;
    default:
        system("cls");
        kiko::erorr();
        kiko::alert(3);
        system("cls");
    }
}
int main()
{
    int choice = Choice();
    runProcessOfUser(choice);
    return 0;
}
