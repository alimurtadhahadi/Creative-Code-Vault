void runPowerAndBaseProgram()
{
    float base, exponent;
    cout << "\n=== Power & Base Calculator ===\n";
    cout << "Please enter Base number: ";
    cin >> base;
    cout << "Please enter Exponent (Power): ";
    cin >> exponent;

    float result = kiko::calculatePower(base, exponent);

    cout << "\nEquation: " << base << " ^ " << exponent << endl;
    cout << "Total Result = " << result << endl;
}
void runRootsProgram()
{
    float number;
    int degree;
    cout << "\n=== Roots Calculator ===\n";
    cout << "Please enter the Number: ";
    cin >> number;
    cout << "Please enter Root Degree (2 for sqrt, 3 for cbrt, 4, 5...): ";
    cin >> degree;

    float result = kiko::calculateRoot(number, degree);

    if (result != 0.0f || number == 0.0f) {
        cout << "\nEquation: Root(" << degree << ") of " << number << endl;
        cout << "Total Result = " << result << endl;
    }
}
