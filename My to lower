#include <iostream>
#include <string>
using namespace std;
string MyToLower(string str)
{
    for (int i = 0; i < str.length(); i++) {
        if (str[i] >= 65 && str[i] <= 90) {
            str[i] += 32;
        }
    }
    return str;
}
int main()
{
    string Answer;
    string str = "";
        cout << "Please Agree to continue : ";
        cin >> Answer;
        str = MyToLower(Answer);
        cout << str;
}
