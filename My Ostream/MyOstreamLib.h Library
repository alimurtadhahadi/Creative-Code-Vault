#pragma once
#include <iostream>
#include <string>
#include <sstream>
#include <iomanip>

namespace kiko
{
    struct Arg
    {
        std::string strVal;
        double numVal;
        bool isString;

        Arg() : strVal(""), numVal(0), isString(false) {}
        Arg(int v) : strVal(""), numVal(v), isString(false) {}
        Arg(double v) : strVal(""), numVal(v), isString(false) {}
        Arg(float v) : strVal(""), numVal(v), isString(false) {}
        Arg(const char* s) : strVal(s ? s : ""), numVal(0), isString(true) {}
        Arg(const std::string& s) : strVal(s), numVal(0), isString(true) {}
    };

    void MyCout(std::string Text)
    {
        std::cout << Text;
    }

    void MyPrintf(std::string Text, Arg Num1 = Arg(), Arg Num2 = Arg(), Arg Num3 = Arg(), Arg Num4 = Arg(), Arg Num5 = Arg())
    {
        Arg Args[5] = { Num1, Num2, Num3, Num4, Num5 };
        int ArgCounter = 0;

        for (int i = 0; i < Text.length(); i++)
        {
            if (Text[i] == '%')
            {
                if ((i + 1 < Text.length()) && (Text[i + 1] == 'd' || Text[i + 1] == 'f'))
                {
                    if (ArgCounter < 5)
                    {
                        if (Text[i + 1] == 'd')
                        {
                            if (Args[ArgCounter].isString)
                                std::cout << Args[ArgCounter].strVal;
                            else
                                std::cout << (int)Args[ArgCounter].numVal;
                        }
                        else
                        {
                            if (Args[ArgCounter].isString)
                            {
                                std::cout << Args[ArgCounter].strVal;
                            }
                            else
                            {
                                std::ostringstream oss;
                                oss << std::fixed << std::setprecision(6) << Args[ArgCounter].numVal;
                                std::cout << oss.str();
                            }
                        }
                        ArgCounter++;
                    }
                    i++;
                }
                else if ((i + 3 < Text.length()) && Text[i + 1] == '0' && Text[i + 2] == '*' && Text[i + 3] == 'd')
                {
                    if (ArgCounter + 1 < 5)
                    {
                        int width = (int)Args[ArgCounter].numVal;
                        int value = (int)Args[ArgCounter + 1].numVal;
                        ArgCounter += 2;

                        std::string valStr = std::to_string(value);
                        int zerosToAdd = width - (int)valStr.length();

                        if (value < 0)
                        {
                            std::cout << '-';
                            valStr = valStr.substr(1);
                        }

                        for (int z = 0; z < zerosToAdd; z++)
                        {
                            std::cout << '0';
                        }

                        std::cout << valStr;
                    }
                    i += 3;
                }
                else if ((i + 1 < Text.length()) && Text[i + 1] == '.')
                {
                    if ((i + 3 < Text.length()) && Text[i + 2] == '*' && (Text[i + 3] == 'd' || Text[i + 3] == 'f'))
                    {
                        if (ArgCounter + 1 < 5)
                        {
                            int precision = (int)Args[ArgCounter].numVal;
                            Arg valueArg = Args[ArgCounter + 1];
                            ArgCounter += 2;

                            if (Text[i + 3] == 'd')
                            {
                                int intVal = (int)valueArg.numVal;
                                std::string valStr = std::to_string(intVal);

                                if (intVal < 0)
                                {
                                    std::cout << '-';
                                    valStr = valStr.substr(1);
                                }

                                int zerosToAdd = precision - (int)valStr.length();
                                for (int z = 0; z < zerosToAdd; z++)
                                {
                                    std::cout << '0';
                                }

                                std::cout << valStr;
                            }
                            else
                            {
                                std::ostringstream oss;
                                oss << std::fixed << std::setprecision(precision) << valueArg.numVal;
                                std::cout << oss.str();
                            }
                        }
                        i += 3;
                    }
                    else
                    {
                        int j = i + 2;
                        int precision = 0;
                        bool foundDigit = false;

                        while (j < Text.length() && Text[j] >= '0' && Text[j] <= '9')
                        {
                            precision = (precision * 10) + (Text[j] - '0');
                            foundDigit = true;
                            j++;
                        }

                        if (foundDigit && j < Text.length() && (Text[j] == 'd' || Text[j] == 'f'))
                        {
                            if (ArgCounter < 5)
                            {
                                Arg valueArg = Args[ArgCounter];
                                ArgCounter++;

                                if (Text[j] == 'd')
                                {
                                    int intVal = (int)valueArg.numVal;
                                    std::string valStr = std::to_string(intVal);

                                    if (intVal < 0)
                                    {
                                        std::cout << '-';
                                        valStr = valStr.substr(1);
                                    }

                                    int zerosToAdd = precision - (int)valStr.length();
                                    for (int z = 0; z < zerosToAdd; z++)
                                    {
                                        std::cout << '0';
                                    }

                                    std::cout << valStr;
                                }
                                else
                                {
                                    std::ostringstream oss;
                                    oss << std::fixed << std::setprecision(precision) << valueArg.numVal;
                                    std::cout << oss.str();
                                }
                            }
                            i = j;
                        }
                        else
                        {
                            std::cout << Text[i];
                        }
                    }
                }
                else if ((i + 1 < Text.length()) && Text[i + 1] == 's')
                {
                    if (ArgCounter < 5)
                    {
                        if (Args[ArgCounter].isString)
                        {
                            std::cout << Args[ArgCounter].strVal;
                        }
                        else
                        {
                            std::cout << (int)Args[ArgCounter].numVal;
                        }
                        ArgCounter++;
                    }
                    i++;
                }
                else if ((i + 1 < Text.length()) && Text[i + 1] == '*')
                {
                    if (i + 2 < Text.length())
                    {
                        char type = Text[i + 2];
                        if (type == 'd' || type == 'f' || type == 's')
                        {
                            if (ArgCounter + 1 < 5)
                            {
                                int width = (int)Args[ArgCounter].numVal;
                                ArgCounter++;

                                std::string strOut = "";
                                if (type == 's')
                                {
                                    strOut = Args[ArgCounter].isString ? Args[ArgCounter].strVal : std::to_string((int)Args[ArgCounter].numVal);
                                }
                                else if (type == 'd')
                                {
                                    strOut = std::to_string((int)Args[ArgCounter].numVal);
                                }
                                else if (type == 'f')
                                {
                                    std::ostringstream oss;
                                    oss << std::fixed << std::setprecision(6) << Args[ArgCounter].numVal;
                                    strOut = oss.str();
                                }

                                int spacesToAdd = width - (int)strOut.length();
                                for (int s = 0; s < spacesToAdd; s++)
                                {
                                    std::cout << ' ';
                                }
                                std::cout << strOut;
                                ArgCounter++;
                            }
                            i += 2;
                        }
                        else
                        {
                            std::cout << Text[i];
                        }
                    }
                    else
                    {
                        std::cout << Text[i];
                    }
                }
                else
                {
                    std::cout << Text[i];
                }
            }
            else
            {
                std::cout << Text[i];
            }
        }
    }
}
