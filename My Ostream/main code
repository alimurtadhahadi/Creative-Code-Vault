#include <iostream>
#include <cstdio>
#include "MyOstreamLib.h"

using namespace std;

int main()
{
    float PI = 3.14159265;
    float x = 7.0, y = 9.0;
    double d = 12.45;
    int posInt = 42;
    int negInt = -42;

    cout << "===============================================================================\n";
    cout << "                     [ 1 ] Standard C Library (printf)                         \n";
    cout << "===============================================================================\n";

    printf("1. Basic Integers      : %d     | Negative: %d \n", posInt, negInt);
    //=======================================================================================
    printf("2. Zero-padded Width   : %0*d  | Negative: %0*d \n", 5, posInt, 6, negInt);
    //=======================================================================================
    printf("3. Integer Precision   : %.*d  | Negative: %.*d \n", 5, posInt, 5, negInt);
    //=======================================================================================
    printf("4. Fixed Int Precision : %.5d  | Negative: %.6d \n", posInt, negInt);
    //=======================================================================================
    printf("5. Float Var Precision : %.*f   | %.*f \n", 2, PI, 4, PI);
    //=======================================================================================
    printf("6. Float Division      : %.10f / %.3f = %.3f \n", x, y, x / y);
    //=======================================================================================
    printf("7. Double Values       : %.3f | %.4f \n", d, d);

    cout << "\n===============================================================================\n";
    cout << "                     [ 2 ] Kiko Custom Library (MyPrintf)                      \n";
    cout << "===============================================================================\n";

    kiko::MyPrintf("1. Basic Integers      : %d     | Negative: %d \n", posInt, negInt);
    //=======================================================================================
    kiko::MyPrintf("2. Zero-padded Width   : %0*d  | Negative: %0*d \n", 5, posInt, 6, negInt);
    //=======================================================================================
    kiko::MyPrintf("3. Integer Precision   : %.*d  | Negative: %.*d \n", 5, posInt, 5, negInt);
    //=======================================================================================
    kiko::MyPrintf("4. Fixed Int Precision : %.5d  | Negative: %.6d \n", posInt, negInt);
    //=======================================================================================
    kiko::MyPrintf("5. Float Var Precision : %.*f   | %.*f \n", 2, PI, 4, PI);
    //=======================================================================================
    kiko::MyPrintf("6. Float Division      : %.10f / %.3f = %.3f \n", x, y, x / y);
    //=======================================================================================
    kiko::MyPrintf("7. Double Values       : %.3f | %.4f \n", d, d);

    kiko::MyCout("===============================================================================\n");

    return 0;
}
