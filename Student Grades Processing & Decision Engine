    ReadGrades(GradesBefore, NumberOfSubjects);
    RoundingGrades(PassOrFail, GradesBefore, GradesAfter, NumberOfSubjects);
    PrintingGradesAfterRounding(PassOrFail, GradesBefore, GradesAfter, NumberOfSubjects);
}
