void ReadGrades(float Grades[], int NumberOfSubjects)
{
    cout << "\nPlease enter your " << NumberOfSubjects;
    (NumberOfSubjects == 1) ? cout << " Grade\n" : cout << " Grades\n";
    cout << "(Must be greater than 0 or smaller than 100)\n";

    for (int i = 0; i < NumberOfSubjects; i++) {
        do {
            cout << "Subject " << i + 1 << " : ";
            cin >> Grades[i];
            if (Grades[i] < 0 || Grades[i] > 100) {
                RedAlert(3);
                cout << "\033[A\033[2K";
            }
        } while (Grades[i] < 0 || Grades[i] > 100);
    }
}
void RoundingGrades(string PassOrFail[], float GradesBefore[], int GradesAfter[], int NumberOfSubjects)
{
    for (int i = 0; i < NumberOfSubjects; i++) {
        GradesAfter[i] = round(GradesBefore[i]);

        if (GradesAfter[i] >= 50) {
            PassOrFail[i] = "Passed";
        }
        else {
            if (GradesAfter[i] >= 45 && GradesAfter[i] < 50) {
                GradesAfter[i] += 5;
                PassOrFail[i] = "Passed by Decision";
            }
            else {
                PassOrFail[i] = "Failed";
            }
        }
    }
}
void PrintingGradesAfterRounding(string PassOrFail[], float GradesBefore[], int GradesAfter[], int NumberOfSubjects)
{
    int sum = 0;
    float Avr = 0;

    cout << "\n===========================================================\n";
    cout << "Subject\tGrade Before\tGrade After\tStatus\n";
    cout << "===========================================================\n";

    for (int i = 0; i < NumberOfSubjects; i++) {
        cout << i + 1 << ". \t" << GradesBefore[i] << " \t\t" << GradesAfter[i] << " \t\t" << PassOrFail[i] << endl;
        sum += GradesAfter[i];
    }

    Avr = (float)sum / NumberOfSubjects;

    cout << "-----------------------------------------------------------\n";
    cout << "The Sum is     : " << sum << endl;
    cout << "The Average is : " << Avr << endl;
    cout << "-----------------------------------------------------------\n";

    if (Avr >= 50) {
        cout << "Congratulations, You Passed! :-) " << endl;
        GreenAlert(5);
    }
    else {
        if (Avr <= 10) {
            cout << "Are you donkey, are you stupid, What are these Grades?!" << endl;
            RedAlert(100);
        }
        else {
            cout << "Failed, Good luck next year :-(" << endl;
            RedAlert(5);
        }
    }
}
void endTheProgram()
{
